{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "rootDir": ".",
    "types": ["node"],
    // Type assertions are unused by construction: `type _x = Expect<Equals<…>>`
    // exists to fail compilation, never to be referenced.
    "noUnusedLocals": false,
    "noUnusedParameters": false
  },
  "include": ["src/**/*", "test/**/*.ts"]
}
